# --- Required API keys ---
MISTRAL_API_KEY=your_mistral_key_here
SARVAM_API_KEY=your_sarvam_key_here

# Optional - raises Hugging Face rate limits for embedding model downloads
HF_TOKEN=

# --- Transcription ---
WHISPER_MODEL=small
SARVAM_STT_MODEL=saaras.5

# --- Audio ---
DOWNLOAD_DIR=downloads
YT_COOKIEFILE=cookies.txt

# --- RAG ---
VECTOR_DB_DIR=vector_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- CORS: comma-separated list is NOT supported by pydantic-settings list parsing
# by default here - for multiple origins, set as a JSON array string, e.g.:
# CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
CORS_ORIGINS=["*"]
